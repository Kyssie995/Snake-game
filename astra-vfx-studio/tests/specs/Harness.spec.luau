--!strict
-- Sanity checks for the test harness itself (runs in Lune and in Studio).
return function(T: any, _use: (string) -> any, ctx: any)
	T.describe("TestFramework", function()
		T.it("compares deeply", function()
			T.expect({ a = 1, b = { 2, 3 } }).toEqual({ a = 1, b = { 2, 3 } })
			T.expect({ a = 1 }).never.toEqual({ a = 2 })
		end)
		T.it("compares Roblox datatypes approximately", function()
			T.expect(Vector3.new(1, 2, 3)).toBeCloseTo(Vector3.new(1, 2, 3.00001), 1e-3)
			T.expect(Color3.new(1, 0, 0)).never.toBeCloseTo(Color3.new(0, 1, 0))
		end)
		T.it("detects thrown errors", function()
			T.expect(function()
				error("boom")
			end).toThrow("boom")
		end)
	end)
	T.describe("Engine", function()
		T.it("rejects invalid property names (reflection database)", function()
			local e = Instance.new("ParticleEmitter")
			T.expect(function()
				(e :: any).NotAProperty = 1
			end).toThrow()
		end)
		T.itIf(ctx.environment == "lune", "records ParticleEmitter:Emit via fakes", function()
			local e = Instance.new("ParticleEmitter")
			e:Emit(7)
			T.expect(ctx.fakes:totalEmitted(e)).toBe(7)
		end)
	end)
end
